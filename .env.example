# ================================
# TaskMitra Environment Variables
# ================================

# ------------------------------
# Firebase Configuration
# ------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ------------------------------
# Firebase Admin (Optional for Cloud Functions)
# ------------------------------
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_PROJECT_ID=

# ------------------------------
# Razorpay Configuration (Future)
# ------------------------------
REACT_APP_RAZORPAY_KEY_ID=
REACT_APP_RAZORPAY_KEY_SECRET=

# ------------------------------
# General App Configuration
# ------------------------------
REACT_APP_DEFAULT_USER_ROLE=customer
REACT_APP_DEFAULT_WORKER_ROLE=worker
REACT_APP_APP_NAME=TaskMitra
REACT_APP_REGION=AndhraPradesh

# ------------------------------
# Feature Flags (optional)
# ------------------------------
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_REVIEWS=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# ------------------------------
# Analytics / Monitoring (optional)
# ------------------------------
REACT_APP_GOOGLE_ANALYTICS_ID=
